# =============================================================
# AlkaFolio API — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/alkafolio?retryWrites=true&w=majority

# JWT — use a long, random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret

# Anthropic — used by AlkaBot (/api/chat)
ANTHROPIC_API_KEY=sk-ant-...

# Email OTP (optional)
# If unset, the OTP is returned directly in the signup response (dev-friendly).
# Supports Gmail app passwords or any SMTP provider via nodemailer.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# CoinGecko (optional)
# Free tier works without a key. Add a key for higher rate limits.
# https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=CG-...
