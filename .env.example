# AlkaFolio API — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/alkafolio?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Anthropic (AlkaBot)
ANTHROPIC_API_KEY=sk-ant-...

# Email OTP — Gmail app password. If unset, OTP is returned in the signup response.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# CoinGecko — optional, free tier works without a key
COINGECKO_API_KEY=CG-...
