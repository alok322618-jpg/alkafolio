# AlkaFolio API — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/alkafolio?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Anthropic (AlkaBot)
ANTHROPIC_API_KEY=sk-ant-...

# EmailJS — OTP delivery via https://www.emailjs.com
# If unset, OTP is returned in the signup response (dev fallback).
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# CoinGecko — optional, free tier works without a key
COINGECKO_API_KEY=CG-...
